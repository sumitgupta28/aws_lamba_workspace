# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Terraform — provider cache and plugin downloads
**/.terraform/
**/.terraform.lock.hcl

# Terraform — state files (may contain secrets in plain text)
**/*.tfstate
**/*.tfstate.*

# Terraform — variable files (often contain secrets)
**/*.tfvars
**/*.tfvars.json

# Terraform — crash logs
**/crash.log
**/crash.*.log

# Terraform — local override files (not for version control)
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# Terraform — local CLI config (may contain credentials)
**/.terraformrc
**/terraform.rc

# Lambda build artifact (regenerated by scripts/package.sh)
**/lambda.zip
**/layer.zip
